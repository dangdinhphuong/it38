@model ShopeeClone.Models.Model_DB.SanPham

@{
    ViewData["Title"] = Model?.TenSanPham ?? "Chi tiết sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var isOutOfStock = Model != null && Model.SoLuongTon <= 0;
    var categoryName = Model?.DanhMuc?.TenDanhMuc ?? "Sản phẩm";
    var categoryId = Model?.DanhMuc?.MaDanhMuc ?? 1;
    var imgSrc = string.IsNullOrEmpty(Model?.HinhAnh) ? "/images/no-image.png" : Model.HinhAnh;
}

@section Styles {
    <style>
        .product-detail-page {
            padding: 1.5rem 0 3.5rem;
        }

        /* Product Main Showcase Card */
        .product-showcase-card {
            background-color: var(--bg-surface);
            border: 1px solid var(--border-default);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-sm);
            padding: 1.75rem;
            margin-bottom: 2rem;
        }

        /* Gallery */
        .detail-gallery {
            position: sticky;
            top: 90px;
        }

        .main-image-wrap {
            position: relative;
            width: 100%;
            padding-top: 100%; /* 1:1 Aspect */
            border-radius: var(--radius-md);
            overflow: hidden;
            background-color: var(--bg-surface-sunken);
            border: 1px solid var(--border-subtle);
            margin-bottom: 1rem;
        }

        .main-image-wrap img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .main-image-wrap:hover img {
            transform: scale(1.06);
        }

        .thumb-gallery-strip {
            display: flex;
            gap: 0.6rem;
            overflow-x: auto;
            padding-bottom: 0.5rem;
        }

        .thumb-gallery-item {
            width: 72px;
            height: 72px;
            flex-shrink: 0;
            border-radius: var(--radius-sm);
            border: 2px solid transparent;
            overflow: hidden;
            cursor: pointer;
            transition: all var(--transition-fast);
            background-color: var(--bg-surface-sunken);
        }

        .thumb-gallery-item:hover,
        .thumb-gallery-item.active {
            border-color: var(--shopee-orange);
            transform: scale(1.04);
        }

        .thumb-gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Product Details Info */
        .detail-info-title {
            font-size: 1.35rem;
            font-weight: 700;
            color: var(--text-primary);
            line-height: 1.4;
            margin-bottom: 0.75rem;
        }

        .detail-rating-row {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 1.25rem;
            padding-bottom: 1rem;
            margin-bottom: 1.25rem;
            border-bottom: 1px solid var(--border-subtle);
            font-size: 0.875rem;
        }

        .rating-badge-group {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            color: var(--shopee-orange);
            font-weight: 700;
        }

        .rating-divider {
            width: 1px;
            height: 16px;
            background-color: var(--border-default);
        }

        /* Price Box */
        .detail-price-box {
            background-color: var(--bg-surface-sunken);
            border-radius: var(--radius-md);
            padding: 1.25rem 1.5rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .current-price {
            font-size: 2rem;
            font-weight: 800;
            color: var(--shopee-orange);
            line-height: 1;
        }

        .original-price {
            font-size: 1.1rem;
            color: var(--text-muted);
            text-decoration: line-through;
        }

        .price-discount-tag {
            background: linear-gradient(135deg, #ee4d2d, #ff6535);
            color: #ffffff;
            font-weight: 700;
            font-size: 0.8125rem;
            padding: 2px 8px;
            border-radius: var(--radius-xs);
        }

        /* Service Guarantee Row */
        .guarantee-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 0.75rem;
            padding: 1rem;
            background: var(--bg-surface);
            border: 1px dashed var(--border-strong);
            border-radius: var(--radius-sm);
            margin-bottom: 1.5rem;
        }

        .guarantee-item {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            font-size: 0.8125rem;
            color: var(--text-secondary);
        }

        .guarantee-item i {
            color: var(--shopee-orange);
            font-size: 1.1rem;
        }

        /* Quantity Selector */
        .quantity-section {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .quantity-controller {
            display: inline-flex;
            align-items: center;
            border: 1.5px solid var(--border-default);
            border-radius: var(--radius-sm);
            overflow: hidden;
            background-color: var(--bg-surface);
        }

        .quantity-controller button {
            width: 38px;
            height: 38px;
            background: var(--bg-surface-sunken);
            border: none;
            color: var(--text-primary);
            font-size: 1.1rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: background var(--transition-fast);
        }

        .quantity-controller button:hover:not(:disabled) {
            background-color: var(--border-default);
        }

        .quantity-controller input {
            width: 55px;
            height: 38px;
            border: none;
            text-align: center;
            font-weight: 700;
            color: var(--text-primary);
            background: transparent;
            outline: none;
        }

        /* Action Buttons */
        .detail-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .btn-add-to-cart {
            background-color: var(--shopee-orange-light);
            border: 1.5px solid var(--shopee-orange);
            color: var(--shopee-orange) !important;
            padding: 0.75rem 1.75rem;
            border-radius: var(--radius-sm);
            font-size: 1rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            cursor: pointer;
            transition: all var(--transition-fast);
        }

        .btn-add-to-cart:hover:not(:disabled) {
            background-color: var(--shopee-orange);
            color: #ffffff !important;
            transform: translateY(-2px);
            box-shadow: var(--shadow-glow-sm);
        }

        .btn-buy-now {
            background: var(--shopee-gradient);
            border: none;
            color: #ffffff !important;
            padding: 0.75rem 2.25rem;
            border-radius: var(--radius-sm);
            font-size: 1rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: var(--shadow-glow-sm);
            transition: all var(--transition-fast);
        }

        .btn-buy-now:hover:not(:disabled) {
            background: linear-gradient(135deg, #f04815 0%, #d83b1c 100%);
            box-shadow: var(--shadow-glow);
            transform: translateY(-2px);
        }

        /* Modern Tabs */
        .detail-tabs-wrapper {
            background-color: var(--bg-surface);
            border: 1px solid var(--border-default);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-sm);
            overflow: hidden;
        }

        .detail-tabs-header {
            display: flex;
            background-color: var(--bg-surface-sunken);
            border-bottom: 1px solid var(--border-default);
        }

        .detail-tab-btn {
            padding: 1rem 1.75rem;
            font-weight: 600;
            font-size: 0.9375rem;
            color: var(--text-secondary);
            border: none;
            background: transparent;
            cursor: pointer;
            border-bottom: 2px solid transparent;
            transition: all var(--transition-fast);
        }

        .detail-tab-btn:hover {
            color: var(--shopee-orange);
        }

        .detail-tab-btn.active {
            color: var(--shopee-orange);
            background-color: var(--bg-surface);
            border-bottom: 3px solid var(--shopee-orange);
        }

        .detail-tab-content {
            padding: 1.75rem;
        }

        .detail-spec-table th {
            width: 220px;
            color: var(--text-secondary);
            font-weight: 500;
            background-color: var(--bg-surface-sunken);
        }
    </style>
}

<div class="product-detail-page">
    <div class="container">

        <!-- BREADCRUMB -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house me-1"></i>Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-controller="VwSanPham" asp-action="Dashboard" asp-route-id="@categoryId">@categoryName</a></li>
                <li class="breadcrumb-item active" aria-current="page">@(Model?.TenSanPham ?? "Chi tiết sản phẩm")</li>
            </ol>
        </nav>

        @if (Model != null)
        {
            <!-- PRODUCT SHOWCASE CARD (CONTRACT: #mainProductImage, #qtyInput, buttons) -->
            <div class="product-showcase-card">
                <div class="row g-4">

                    <!-- CỘT TRÁI: GALLERY ẢNH -->
                    <div class="col-lg-5">
                        <div class="detail-gallery">
                            <div class="main-image-wrap">
                                <img id="mainProductImage"
                                     src="@imgSrc"
                                     alt="@Model.TenSanPham" />
                            </div>

                            <!-- THUMBNAILS STRIP (CONTRACT: changeImage(src)) -->
                            <div class="thumb-gallery-strip">
                                <div class="thumb-gallery-item active" onclick="changeImage('@imgSrc', this)">
                                    <img src="@imgSrc" alt="@Model.TenSanPham" />
                                </div>
                                @for (int i = 1; i <= 4; i++)
                                {
                                    <div class="thumb-gallery-item" onclick="changeImage('@imgSrc', this)">
                                        <img src="@imgSrc" alt="@Model.TenSanPham" />
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- CỘT PHẢI: THÔNG TIN CHI TIẾT & HÀNH ĐỘNG -->
                    <div class="col-lg-7">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="tag-mall">Mall</span>
                            <span class="tag-fav">Yêu thích</span>
                            <span class="badge bg-secondary opacity-75 small">Chính Hãng 100%</span>
                        </div>

                        <h1 class="detail-info-title product-name">@Model.TenSanPham</h1>

                        <!-- RATING & META ROW -->
                        <div class="detail-rating-row">
                            <div class="rating-badge-group">
                                <span>4.9</span>
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star-half-stroke"></i>
                            </div>

                            <div class="rating-divider"></div>

                            <div>
                                <strong class="text-primary">1.2k</strong> <span class="text-muted">Đánh giá</span>
                            </div>

                            <div class="rating-divider"></div>

                            <div>
                                <strong class="text-primary">5.4k</strong> <span class="text-muted">Đã bán</span>
                            </div>
                        </div>

                        <!-- GIÁ BÁN & KHUYẾN MÃI -->
                        <div class="detail-price-box">
                            <div class="current-price product-price">@Model.Gia.ToString("N0") ₫</div>
                            <div class="original-price">@((Model.Gia * 1.25m).ToString("N0")) ₫</div>
                            <div class="price-discount-tag">-20% GIẢM</div>
                        </div>

                        <!-- VẬN CHUYỂN & DỊCH VỤ -->
                        <div class="guarantee-row">
                            <div class="guarantee-item">
                                <i class="fa-solid fa-truck-fast"></i>
                                <div>
                                    <div class="fw-semibold">Miễn Phí Vận Chuyển</div>
                                    <div class="text-muted">Giao hàng hoả tốc 2H</div>
                                </div>
                            </div>
                            <div class="guarantee-item">
                                <i class="fa-solid fa-shield-halved"></i>
                                <div>
                                    <div class="fw-semibold">Bảo Hiểm Thiết Bị</div>
                                    <div class="text-muted">Bảo hành chính hãng 12T</div>
                                </div>
                            </div>
                            <div class="guarantee-item">
                                <i class="fa-solid fa-arrow-rotate-left"></i>
                                <div>
                                    <div class="fw-semibold">15 Ngày Đổi Trả</div>
                                    <div class="text-muted">Miễn phí nếu lỗi NSX</div>
                                </div>
                            </div>
                        </div>

                        <!-- SỐ LƯỢNG MUA (CONTRACT: #qtyInput, increaseQty(), decreaseQty()) -->
                        <div class="quantity-section">
                            <span class="text-secondary fw-semibold">Số lượng:</span>
                            <div class="quantity-controller quantity-control">
                                <button type="button"
                                        onclick="decreaseQty()"
                                        aria-label="Giảm số lượng"
                                        @(isOutOfStock ? "disabled" : "")>-</button>
                                <input type="text"
                                       id="qtyInput"
                                       value="1"
                                       aria-label="Số lượng sản phẩm" />
                                <button type="button"
                                        onclick="increaseQty()"
                                        aria-label="Tăng số lượng"
                                        @(isOutOfStock ? "disabled" : "")>+</button>
                            </div>
                            <span class="text-muted small">
                                @if (Model.SoLuongTon > 0)
                                {
                                    <span>Còn lại: <strong class="text-success">@Model.SoLuongTon</strong> sản phẩm có sẵn</span>
                                }
                                else
                                {
                                    <span class="text-danger fw-bold"><i class="fa-solid fa-circle-xmark me-1"></i>Tạm hết hàng</span>
                                }
                            </span>
                        </div>

                        <!-- NÚT HÀNH ĐỘNG (CONTRACT: themVaoGio(maSanPham), muaNgay(maSanPham)) -->
                        <div class="detail-actions">
                            <button type="button"
                                    class="btn-add-to-cart btn-add"
                                    onclick="themVaoGio(@Model.MaSanPham)"
                                    @(isOutOfStock ? "disabled style='opacity:0.5;cursor:not-allowed;'" : "")>
                                <i class="fa-solid fa-cart-plus me-1"></i>
                                <span>Thêm Vào Giỏ Hàng</span>
                            </button>

                            <button type="button"
                                    class="btn-buy-now btn-buy"
                                    onclick="muaNgay(@Model.MaSanPham)"
                                    @(isOutOfStock ? "disabled style='opacity:0.5;cursor:not-allowed;'" : "")>
                                <span>Mua Ngay</span>
                            </button>
                        </div>
                    </div>

                </div>
            </div>

            <!-- TABS CHI TIẾT SẢN PHẨM & MÔ TẢ -->
            <div class="detail-tabs-wrapper">
                <div class="detail-tabs-header" role="tablist">
                    <button type="button" class="detail-tab-btn active" onclick="switchDetailTab('spec-tab', this)">
                        <i class="fa-solid fa-circle-info me-1"></i> Thông Tin Chi Tiết
                    </button>
                    <button type="button" class="detail-tab-btn" onclick="switchDetailTab('desc-tab', this)">
                        <i class="fa-solid fa-align-left me-1"></i> Mô Tả Sản Phẩm
                    </button>
                    <button type="button" class="detail-tab-btn" onclick="switchDetailTab('shipping-tab', this)">
                        <i class="fa-solid fa-truck me-1"></i> Chính Sách Vận Chuyển
                    </button>
                </div>

                <div class="detail-tab-content">
                    <!-- TAB 1: THÔNG SỐ -->
                    <div id="spec-tab" class="detail-tab-pane">
                        <div class="table-responsive">
                            <table class="table table-bordered detail-spec-table mb-0">
                                <tbody>
                                    <tr>
                                        <th>Mã sản phẩm</th>
                                        <td>#@Model.MaSanPham</td>
                                    </tr>
                                    <tr>
                                        <th>Tên sản phẩm</th>
                                        <td class="fw-semibold">@Model.TenSanPham</td>
                                    </tr>
                                    <tr>
                                        <th>Danh mục</th>
                                        <td>@(Model.DanhMuc != null ? Model.DanhMuc.TenDanhMuc : "Không xác định")</td>
                                    </tr>
                                    <tr>
                                        <th>Giá niêm yết</th>
                                        <td class="text-danger fw-bold">@Model.Gia.ToString("N0") ₫</td>
                                    </tr>
                                    <tr>
                                        <th>Số lượng kho</th>
                                        <td>@Model.SoLuongTon</td>
                                    </tr>
                                    <tr>
                                        <th>Tình trạng</th>
                                        <td>
                                            @if (Model.SoLuongTon > 0)
                                            {
                                                <span class="badge-modern badge-status-approved">@Model.TrangThai</span>
                                            }
                                            else
                                            {
                                                <span class="badge-modern badge-status-cancelled">Hết hàng</span>
                                            }
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- TAB 2: MÔ TẢ -->
                    <div id="desc-tab" class="detail-tab-pane d-none">
                        <div class="product-description-body text-secondary">
                            <h5 class="fw-bold text-primary mb-3">Đặc Điểm Nổi Bật Của @Model.TenSanPham</h5>
                            <p>
                                Sản phẩm <strong>@Model.TenSanPham</strong> được phân phối chính hãng 100% trên ShopeeClone,
                                sở hữu thiết kế tinh xảo, chất lượng vượt trội đáp ứng trọn vẹn nhu cầu sử dụng hàng ngày của quý khách.
                            </p>
                            <div class="p-3 bg-light rounded-3 my-3">
                                <h6 class="fw-bold mb-2"><i class="fa-solid fa-circle-check text-success me-2"></i>Cam kết bán hàng từ ShopeeClone:</h6>
                                <ul class="mb-0 ps-3">
                                    <li>100% sản phẩm chính hãng, đầy đủ hoá đơn nguồn gốc.</li>
                                    <li>Kiểm tra hàng trước khi nhận, bao đổi trả trong vòng 15 ngày nếu lỗi nhà sản xuất.</li>
                                    <li>Đóng gói tiêu chuẩn chống sốc, vận chuyển an toàn trên toàn quốc.</li>
                                    <li>Hỗ trợ tư vấn giải đáp kỹ thuật 24/7 từ chuyên viên tận tâm.</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- TAB 3: VẬN CHUYỂN -->
                    <div id="shipping-tab" class="detail-tab-pane d-none">
                        <div class="text-secondary">
                            <h5 class="fw-bold text-primary mb-3">Thông Tin Vận Chuyển &amp; Giao Nhận</h5>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="card-modern p-3 h-100">
                                        <h6 class="fw-bold mb-2"><i class="fa-solid fa-bolt text-warning me-2"></i>Giao hàng Hoả Tốc:</h6>
                                        <p class="small text-muted mb-0">Nhận hàng trong vòng 2 giờ áp dụng cho các khu vực nội thành trung tâm.</p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card-modern p-3 h-100">
                                        <h6 class="fw-bold mb-2"><i class="fa-solid fa-truck text-info me-2"></i>Giao hàng Tiêu Chuẩn:</h6>
                                        <p class="small text-muted mb-0">Từ 1 - 3 ngày làm việc đối với các tỉnh thành trên toàn quốc. Hỗ trợ Freeship đơn từ 0đ.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card-modern p-5 text-center my-5">
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <i class="fa-solid fa-circle-exclamation text-danger"></i>
                    </div>
                    <div class="empty-state-title">Không tìm thấy sản phẩm yêu cầu</div>
                    <div class="empty-state-desc">Sản phẩm có thể đã bị ngừng bán hoặc đường dẫn không hợp lệ.</div>
                    <div class="empty-state-action">
                        <a asp-controller="Home" asp-action="Index" class="btn-shopee">Quay Lại Trang Chủ</a>
                    </div>
                </div>
            </div>
        }

    </div>
</div>

@section Scripts {
    <script>
        // CONTRACT: changeImage(src)
        function changeImage(src, element) {
            const mainImg = document.getElementById("mainProductImage");
            if (mainImg) {
                mainImg.src = src;
            }
            if (element) {
                document.querySelectorAll('.thumb-gallery-item').forEach(el => el.classList.remove('active'));
                element.classList.add('active');
            }
        }

        // CONTRACT: increaseQty()
        function increaseQty() {
            const qtyInput = document.getElementById("qtyInput");
            if (!qtyInput) return;
            let current = parseInt(qtyInput.value) || 1;
            let maxStock = @(Model?.SoLuongTon ?? 9999);
            if (current < maxStock) {
                qtyInput.value = current + 1;
            } else {
                if (window.toast) {
                    window.toast.warning('Bạn đã đạt số lượng tối đa có sẵn trong kho!', 'Thông báo');
                }
            }
        }

        // CONTRACT: decreaseQty()
        function decreaseQty() {
            const qtyInput = document.getElementById("qtyInput");
            if (!qtyInput) return;
            let current = parseInt(qtyInput.value) || 1;
            if (current > 1) {
                qtyInput.value = current - 1;
            }
        }

        // CONTRACT: themVaoGio(maSanPham)
        function themVaoGio(maSanPham) {
            const qtyInput = document.getElementById("qtyInput");
            const soLuong = parseInt(qtyInput ? qtyInput.value : 1) || 1;

            $.ajax({
                url: '/VwGioHang/ThemVaoGio',
                type: 'POST',
                data: {
                    maSanPham: maSanPham,
                    soLuong: soLuong
                },
                success: function (res) {
                    if (res.success) {
                        if (window.toast) {
                            window.toast.success(res.message || 'Đã thêm sản phẩm vào giỏ hàng thành công!', 'Giỏ Hàng');
                        } else {
                            alert(res.message);
                        }
                        const badge = document.querySelector('.cart .badge');
                        if (badge) {
                            let cur = parseInt(badge.textContent) || 0;
                            badge.textContent = cur + soLuong;
                        }
                    } else {
                        if (window.toast) {
                            window.toast.warning(res.message, 'Thông báo');
                        } else {
                            alert(res.message);
                        }
                        if (res.message === "Vui lòng đăng nhập") {
                            setTimeout(function () {
                                window.location = '/VwTaiKhoan/DangNhap';
                            }, 1200);
                        }
                    }
                },
                error: function () {
                    if (window.toast) {
                        window.toast.error('Có lỗi xảy ra khi thêm vào giỏ hàng.');
                    } else {
                        alert('Có lỗi xảy ra');
                    }
                }
            });
        }

        // CONTRACT: muaNgay(maSanPham)
        function muaNgay(maSanPham) {
            const qtyInput = document.getElementById("qtyInput");
            const soLuong = parseInt(qtyInput ? qtyInput.value : 1) || 1;

            $.ajax({
                url: '/VwGioHang/MuaNgay',
                type: 'POST',
                data: {
                    maSanPham: maSanPham,
                    soLuong: soLuong
                },
                success: function (res) {
                    if (res.success) {
                        if (window.toast) {
                            window.toast.success(res.message || 'Đang chuyển hướng đến giỏ hàng...', 'Thành Công');
                        } else {
                            alert(res.message);
                        }
                        setTimeout(function () {
                            window.location = '/VwGioHang/Dashboard';
                        }, 500);
                    } else {
                        if (window.toast) {
                            window.toast.warning(res.message, 'Thông báo');
                        } else {
                            alert(res.message);
                        }
                        if (res.message === "Vui lòng đăng nhập") {
                            setTimeout(function () {
                                window.location = '/VwTaiKhoan/DangNhap';
                            }, 1200);
                        }
                    }
                },
                error: function () {
                    if (window.toast) {
                        window.toast.error('Có lỗi xảy ra khi thực hiện mua ngay.');
                    } else {
                        alert('Có lỗi xảy ra');
                    }
                }
            });
        }

        // TABS CHUYỂN ĐỔI
        function switchDetailTab(tabId, element) {
            document.querySelectorAll('.detail-tab-pane').forEach(el => el.classList.add('d-none'));
            document.querySelectorAll('.detail-tab-btn').forEach(el => el.classList.remove('active'));

            const target = document.getElementById(tabId);
            if (target) target.classList.remove('d-none');
            if (element) element.classList.add('active');
        }
    </script>
}
