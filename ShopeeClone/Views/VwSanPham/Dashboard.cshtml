@model ShopeeClone.Models.DashboardViewModel

@{
    ViewData["Title"] = "Danh sách sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var currentCategory = Model?.Categories?.FirstOrDefault(x => x.MaDanhMuc == Model?.SelectedCategoryId);
    var categoryName = currentCategory != null ? currentCategory.TenDanhMuc : "Tất cả sản phẩm";
    var productList = Model?.Products?.ToList() ?? new List<ShopeeClone.Models.Model_DB.SanPham>();
}

@section Styles {
    <style>
        .category-dashboard {
            padding: 1.5rem 0 3rem;
        }

        /* Sidebar Styling */
        .category-sidebar {
            background-color: var(--bg-surface);
            border: 1px solid var(--border-default);
            border-radius: var(--radius-md);
            padding: 1.25rem;
            box-shadow: var(--shadow-xs);
            position: sticky;
            top: 90px;
        }

        .category-sidebar-header {
            font-size: 1rem;
            font-weight: 700;
            text-transform: uppercase;
            padding-bottom: 0.75rem;
            margin-bottom: 0.75rem;
            border-bottom: 1.5px solid var(--border-subtle);
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .category-nav-list {
            list-style: none;
            padding-left: 0;
            margin-bottom: 0;
        }

        .category-nav-item {
            margin-bottom: 0.25rem;
        }

        .category-nav-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.6rem 0.85rem;
            border-radius: var(--radius-sm);
            color: var(--text-secondary);
            font-size: 0.9375rem;
            font-weight: 500;
            transition: all var(--transition-fast);
            text-decoration: none;
        }

        .category-nav-link:hover {
            background-color: var(--shopee-orange-light);
            color: var(--shopee-orange);
            transform: translateX(4px);
        }

        .category-nav-link.active {
            background: var(--shopee-gradient);
            color: #ffffff !important;
            font-weight: 700;
            box-shadow: var(--shadow-glow-sm);
        }

        .category-nav-link.active i {
            color: #ffffff;
        }

        /* Content Header & Sorter */
        .category-header-banner {
            background-color: var(--bg-surface);
            border: 1px solid var(--border-default);
            border-radius: var(--radius-md);
            padding: 1rem 1.25rem;
            margin-bottom: 1.25rem;
            box-shadow: var(--shadow-xs);
        }

        .sort-pill-btn {
            background: var(--bg-surface-sunken);
            border: 1px solid var(--border-default);
            color: var(--text-secondary);
            padding: 0.45rem 1rem;
            border-radius: var(--radius-sm);
            font-size: 0.875rem;
            font-weight: 500;
            cursor: pointer;
            transition: all var(--transition-fast);
        }

        .sort-pill-btn:hover {
            border-color: var(--shopee-orange);
            color: var(--shopee-orange);
        }

        .sort-pill-btn.active {
            background-color: var(--shopee-orange);
            border-color: var(--shopee-orange);
            color: #ffffff;
        }

        /* Product Cards */
        .dash-product-card {
            background-color: var(--bg-surface);
            border: 1px solid var(--border-default);
            border-radius: var(--radius-md);
            overflow: hidden;
            position: relative;
            display: flex;
            flex-direction: column;
            height: 100%;
            transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-fast);
            cursor: pointer;
        }

        .dash-product-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
            border-color: var(--shopee-orange);
        }

        .dash-img-wrap {
            position: relative;
            width: 100%;
            padding-top: 100%;
            background-color: var(--bg-surface-sunken);
            overflow: hidden;
        }

        .dash-img-wrap img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform var(--transition-normal);
        }

        .dash-product-card:hover .dash-img-wrap img {
            transform: scale(1.05);
        }

        .dash-card-body {
            padding: 0.75rem;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .dash-card-title {
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--text-primary);
            line-height: 1.4;
            height: 2.8em;
            overflow: hidden;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            margin-bottom: 0.5rem;
        }

        .dash-card-price {
            color: var(--shopee-orange);
            font-weight: 700;
            font-size: 1.1rem;
        }

        .dash-card-stock {
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .btn-add-quick {
            position: absolute;
            bottom: 12px;
            right: 12px;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: var(--shopee-orange);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 8px rgba(238, 77, 45, 0.35);
            transition: all var(--transition-fast);
            border: none;
            cursor: pointer;
            z-index: 3;
        }

        .btn-add-quick:hover {
            transform: scale(1.15);
            background: var(--shopee-orange-hover);
        }

        /* Pagination */
        .dash-pagination .page-link {
            background-color: var(--bg-surface);
            border-color: var(--border-default);
            color: var(--text-primary);
            padding: 0.5rem 0.85rem;
            border-radius: var(--radius-sm);
            margin: 0 3px;
            font-weight: 500;
            transition: all var(--transition-fast);
        }

        .dash-pagination .page-item.active .page-link {
            background: var(--shopee-gradient);
            border-color: var(--shopee-orange);
            color: #ffffff;
            box-shadow: var(--shadow-glow-sm);
        }

        .dash-pagination .page-link:hover:not(.active) {
            background-color: var(--shopee-orange-light);
            color: var(--shopee-orange);
            border-color: var(--shopee-orange);
        }
    </style>
}

<div class="category-dashboard">
    <div class="container">

        <!-- BREADCRUMB -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house me-1"></i>Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">@categoryName</li>
            </ol>
        </nav>

        <div class="row g-4">

            <!-- SIDEBAR DANH MỤC -->
            <aside class="col-lg-3">
                <div class="category-sidebar sidebar">
                    <div class="category-sidebar-header">
                        <i class="fa-solid fa-list-ul text-danger"></i>
                        <span>Tất Cả Danh Mục</span>
                    </div>

                    <ul class="category-nav-list">
                        @if (Model?.Categories != null && Model.Categories.Any())
                        {
                            @foreach (var cat in Model.Categories)
                            {
                                var isActive = Model.SelectedCategoryId == cat.MaDanhMuc;
                                <li class="category-nav-item">
                                    <a href="@Url.Action("Dashboard", "VwSanPham", new { id = cat.MaDanhMuc, page = 1 })"
                                       class="category-nav-link @(isActive ? "active" : "")">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="fa-solid fa-folder@(isActive ? "-open" : "") small opacity-75"></i>
                                            <span>@cat.TenDanhMuc</span>
                                        </div>
                                        <i class="fa-solid fa-chevron-right small opacity-50"></i>
                                    </a>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="text-muted px-2 py-2 small">
                                Không có danh mục nào.
                            </li>
                        }
                    </ul>
                </div>
            </aside>

            <!-- MAIN CONTENT -->
            <main class="col-lg-9">

                <!-- CONTENT HEADER & SORT TOOLBAR -->
                <div class="category-header-banner">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
                        <div>
                            <h2 class="h5 fw-bold mb-1 text-primary current-category-title">
                                <i class="fa-solid fa-layer-group text-danger me-2"></i>@categoryName
                            </h2>
                            <p class="text-muted small mb-0">Hiển thị @productList.Count sản phẩm trong trang này</p>
                        </div>

                        <!-- Client Live Filter Input -->
                        <div class="input-group input-group-sm" style="max-width: 240px;">
                            <span class="input-group-text bg-transparent border-end-0 text-muted">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </span>
                            <input type="text"
                                   id="categorySearchInput"
                                   class="form-control border-start-0"
                                   placeholder="Lọc tên sản phẩm..."
                                   aria-label="Lọc sản phẩm" />
                        </div>
                    </div>

                    <!-- Client-Side Sorter Buttons -->
                    <div class="d-flex align-items-center flex-wrap gap-2 pt-2 border-top">
                        <span class="text-secondary small fw-semibold me-1">Sắp xếp theo:</span>
                        <div class="d-flex flex-wrap gap-2" role="group" aria-label="Sắp xếp sản phẩm">
                            <button type="button" class="sort-pill-btn active" data-sort="default">Mới nhất</button>
                            <button type="button" class="sort-pill-btn" data-sort="price-asc">Giá thấp đến cao</button>
                            <button type="button" class="sort-pill-btn" data-sort="price-desc">Giá cao đến thấp</button>
                            <button type="button" class="sort-pill-btn" data-sort="in-stock">Còn hàng</button>
                        </div>
                    </div>
                </div>

                <!-- PRODUCT GRID -->
                <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3 product-grid" id="catProductGrid">
                    @if (productList.Any())
                    {
                        int idx = 0;
                        @foreach (var item in productList)
                        {
                            idx++;
                            bool isOutOfStock = item.SoLuongTon <= 0;
                            bool isLowStock = item.SoLuongTon > 0 && item.SoLuongTon <= 5;

                            <div class="col cat-product-item"
                                 data-id="@item.MaSanPham"
                                 data-name="@item.TenSanPham.ToLower()"
                                 data-price="@((long)item.Gia)"
                                 data-stock="@item.SoLuongTon"
                                 data-index="@idx">

                                <div class="dash-product-card"
                                     onclick="location.href='@Url.Action("ChiTietSanPham", "VwSanPham", new { id = item.MaSanPham })'">

                                    @if (isLowStock)
                                    {
                                        <span class="badge-modern badge-status-warning position-absolute top-0 start-0 m-2 z-2">
                                            Sắp hết
                                        </span>
                                    }
                                    else if (isOutOfStock)
                                    {
                                        <span class="badge-modern badge-status-cancelled position-absolute top-0 start-0 m-2 z-2">
                                            Hết hàng
                                        </span>
                                    }

                                    <div class="dash-img-wrap">
                                        <img src="@(string.IsNullOrEmpty(item.HinhAnh) ? "/images/no-image.png" : item.HinhAnh)"
                                             alt="@item.TenSanPham"
                                             loading="lazy" />
                                    </div>

                                    <div class="dash-card-body">
                                        <div class="dash-card-title" title="@item.TenSanPham">
                                            @item.TenSanPham
                                        </div>

                                        <div class="d-flex gap-1 mb-2">
                                            <span class="tag-mall">Mall</span>
                                            <span class="tag-fav">Yêu thích</span>
                                        </div>

                                        <div class="d-flex align-items-baseline justify-content-between mt-auto">
                                            <div class="dash-card-price">
                                                @item.Gia.ToString("N0") ₫
                                            </div>
                                            <div class="dash-card-stock">
                                                @(isOutOfStock ? "Hết hàng" : $"Còn {item.SoLuongTon}")
                                            </div>
                                        </div>
                                    </div>

                                    <button type="button"
                                            class="btn-add-quick"
                                            title="Thêm vào giỏ"
                                            onclick="themVaoGioNhanh(@item.MaSanPham, event)"
                                            @(isOutOfStock ? "disabled style='opacity:0.4;cursor:not-allowed;'" : "")>
                                        <i class="fas fa-cart-plus"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12 py-5">
                            <div class="empty-state">
                                <div class="empty-state-icon">
                                    <i class="fa-solid fa-box-open"></i>
                                </div>
                                <div class="empty-state-title">Danh mục này hiện chưa có sản phẩm</div>
                                <div class="empty-state-desc">Hãy dạo quanh xem các danh mục khác hoặc quay lại sau bạn nhé!</div>
                                <div class="empty-state-action">
                                    <a asp-controller="Home" asp-action="Index" class="btn-shopee">Về Trang Chủ Mua Sắm</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- NO SEARCH FILTER RESULTS -->
                <div id="noCatFilterResult" class="col-12 py-5 d-none">
                    <div class="empty-state">
                        <div class="empty-state-icon">
                            <i class="fa-solid fa-filter-circle-xmark"></i>
                        </div>
                        <div class="empty-state-title">Không tìm thấy sản phẩm khớp bộ lọc</div>
                        <div class="empty-state-desc">Vui lòng thử gõ từ khoá khác hoặc bỏ chọn sắp xếp.</div>
                        <div class="empty-state-action">
                            <button type="button" class="btn-shopee-secondary" onclick="resetCatFilter()">Xóa lọc tìm kiếm</button>
                        </div>
                    </div>
                </div>

                <!-- PAGINATION (GIỮ NGUYÊN ROUTE VwSanPham/Dashboard?id={id}&page={page}) -->
                @if (Model != null && Model.TotalPages > 1)
                {
                    <div class="d-flex justify-content-center mt-4">
                        <nav aria-label="Điều hướng trang sản phẩm">
                            <ul class="pagination dash-pagination mb-0">
                                <!-- PREVIOUS -->
                                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       href="@Url.Action("Dashboard", "VwSanPham", new { id = Model.SelectedCategoryId, page = Model.CurrentPage - 1 })"
                                       aria-label="Trang trước">
                                        <i class="fa-solid fa-chevron-left"></i>
                                    </a>
                                </li>

                                <!-- PAGE NUMBERS -->
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link"
                                           href="@Url.Action("Dashboard", "VwSanPham", new { id = Model.SelectedCategoryId, page = i })">
                                            @i
                                        </a>
                                    </li>
                                }

                                <!-- NEXT -->
                                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       href="@Url.Action("Dashboard", "VwSanPham", new { id = Model.SelectedCategoryId, page = Model.CurrentPage + 1 })"
                                       aria-label="Trang tiếp theo">
                                        <i class="fa-solid fa-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }

            </main>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            initCategoryFilteringAndSorting();
        });

        function themVaoGioNhanh(maSanPham, event) {
            if (event) {
                event.stopPropagation();
                event.preventDefault();
            }

            $.ajax({
                url: '/VwGioHang/ThemVaoGio',
                type: 'POST',
                data: {
                    maSanPham: maSanPham,
                    soLuong: 1
                },
                success: function (res) {
                    if (res.success) {
                        if (window.toast) {
                            window.toast.success(res.message || 'Đã thêm sản phẩm vào giỏ!', 'Giỏ Hàng');
                        } else {
                            alert(res.message);
                        }
                        const badge = document.querySelector('.cart .badge');
                        if (badge) {
                            let cur = parseInt(badge.textContent) || 0;
                            badge.textContent = cur + 1;
                        }
                    } else {
                        if (window.toast) {
                            window.toast.warning(res.message, 'Thông báo');
                        } else {
                            alert(res.message);
                        }
                        if (res.message === "Vui lòng đăng nhập") {
                            setTimeout(function () {
                                window.location = '/VwTaiKhoan/DangNhap';
                            }, 1200);
                        }
                    }
                },
                error: function () {
                    if (window.toast) {
                        window.toast.error('Có lỗi xảy ra khi thêm vào giỏ hàng.');
                    } else {
                        alert('Có lỗi xảy ra');
                    }
                }
            });
        }

        function initCategoryFilteringAndSorting() {
            const grid = document.getElementById('catProductGrid');
            if (!grid) return;

            const sortBtns = document.querySelectorAll('.sort-pill-btn');
            const searchInput = document.getElementById('categorySearchInput');
            const noResEl = document.getElementById('noCatFilterResult');

            function applyFilter() {
                const query = searchInput ? searchInput.value.trim().toLowerCase() : '';
                const activeBtn = document.querySelector('.sort-pill-btn.active');
                const sortType = activeBtn ? activeBtn.dataset.sort : 'default';

                const items = Array.from(grid.querySelectorAll('.cat-product-item'));
                let visibleCount = 0;

                items.forEach(item => {
                    const name = item.dataset.name || '';
                    const stock = parseInt(item.dataset.stock) || 0;
                    let match = true;

                    if (query && !name.includes(query)) match = false;
                    if (sortType === 'in-stock' && stock <= 0) match = false;

                    if (match) {
                        item.classList.remove('d-none');
                        visibleCount++;
                    } else {
                        item.classList.add('d-none');
                    }
                });

                items.sort((a, b) => {
                    const priceA = parseFloat(a.dataset.price) || 0;
                    const priceB = parseFloat(b.dataset.price) || 0;
                    const stockA = parseInt(a.dataset.stock) || 0;
                    const stockB = parseInt(b.dataset.stock) || 0;
                    const idxA = parseInt(a.dataset.index) || 0;
                    const idxB = parseInt(b.dataset.index) || 0;

                    if (sortType === 'price-asc') return priceA - priceB;
                    if (sortType === 'price-desc') return priceB - priceA;
                    if (sortType === 'in-stock') return stockB - stockA;
                    return idxA - idxB;
                });

                items.forEach(item => grid.appendChild(item));

                if (noResEl) {
                    if (visibleCount === 0 && items.length > 0) {
                        noResEl.classList.remove('d-none');
                    } else {
                        noResEl.classList.add('d-none');
                    }
                }
            }

            sortBtns.forEach(btn => {
                btn.addEventListener('click', function () {
                    sortBtns.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    applyFilter();
                });
            });

            if (searchInput) {
                let debounce;
                searchInput.addEventListener('input', function () {
                    clearTimeout(debounce);
                    debounce = setTimeout(applyFilter, 180);
                });
            }
        }

        function resetCatFilter() {
            const input = document.getElementById('categorySearchInput');
            if (input) input.value = '';
            const defBtn = document.querySelector('.sort-pill-btn[data-sort="default"]');
            if (defBtn) defBtn.click();
        }
    </script>
}
