@model ShopeeClone.Models.ViewModels.QuenMatKhauViewModel

@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="auth-page">

    <div class="auth-container">

        <div class="auth-left">
            <h2>Lấy lại mật khẩu</h2>
            <p>Xác minh bằng số điện thoại.</p>
        </div>

        <div class="auth-right">

            <h3 class="auth-title">
                Quên mật khẩu
            </h3>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            <form asp-action="QuenMatKhau"
                  method="post">

                <div class="form-group">

                    <label>Tên đăng nhập</label>

                    <input asp-for="TenDangNhap"
                           class="form-control" />

                    <span asp-validation-for="TenDangNhap"
                          class="text-danger"></span>

                </div>

                <div class="form-group">

                    <label>Số điện thoại</label>

                    <input asp-for="SoDienThoai"
                           class="form-control" />

                    <span asp-validation-for="SoDienThoai"
                          class="text-danger"></span>

                </div>

                <div class="form-group">

                    <label>Mật khẩu mới</label>

                    <input asp-for="MatKhauMoi"
                           type="password"
                           class="form-control" />

                    <span asp-validation-for="MatKhauMoi"
                          class="text-danger"></span>

                </div>

                <div class="form-group">

                    <label>Xác nhận mật khẩu mới</label>

                    <input asp-for="XacNhanMatKhauMoi"
                           type="password"
                           class="form-control" />

                    <span asp-validation-for="XacNhanMatKhauMoi"
                          class="text-danger"></span>

                </div>

                <button type="submit"
                        class="btn-auth">
                    Đặt lại mật khẩu
                </button>

            </form>

            <div class="auth-footer">

                <a asp-action="DangNhap">
                    Quay lại đăng nhập
                </a>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}