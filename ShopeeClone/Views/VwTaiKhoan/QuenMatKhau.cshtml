@model ShopeeClone.Models.ViewModels.QuenMatKhauViewModel

@{
    ViewData["Title"] = "Quên mật khẩu";
}

@section Styles {
    <style>
        .auth-wrapper-section {
            min-height: calc(100vh - 200px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2.5rem 1rem;
            background: linear-gradient(135deg, rgba(238, 77, 45, 0.06) 0%, rgba(255, 115, 55, 0.03) 100%);
        }

        .auth-card-modern {
            background-color: var(--bg-surface);
            border: 1px solid var(--border-default);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-lg);
            overflow: hidden;
            width: 100%;
            max-width: 860px;
        }

        .auth-banner-side {
            background: var(--shopee-gradient);
            color: #ffffff;
            padding: 3rem 2.5rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

        .auth-form-side {
            padding: 3rem 2.5rem;
            background-color: var(--bg-surface);
        }

        .auth-input-group {
            position: relative;
            margin-bottom: 1.15rem;
        }

        .auth-input-group .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 1rem;
            z-index: 2;
        }

        .auth-input-control {
            width: 100%;
            padding: 0.75rem 1rem 0.75rem 2.5rem;
            background-color: var(--bg-surface);
            border: 1.5px solid var(--border-default);
            border-radius: var(--radius-sm);
            color: var(--text-primary);
            font-size: 0.9375rem;
            transition: all var(--transition-fast);
        }

        .auth-input-control:focus {
            outline: none;
            border-color: var(--shopee-orange);
            box-shadow: 0 0 0 3px var(--shopee-orange-glow);
            background-color: var(--bg-surface);
        }

        .toggle-password-btn {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: transparent;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            z-index: 2;
            padding: 4px;
        }

        .btn-auth-submit {
            width: 100%;
            padding: 0.85rem;
            background: var(--shopee-gradient);
            color: #ffffff !important;
            font-weight: 700;
            font-size: 1rem;
            border: none;
            border-radius: var(--radius-sm);
            box-shadow: var(--shadow-glow-sm);
            cursor: pointer;
            transition: all var(--transition-fast);
        }

        .btn-auth-submit:hover {
            box-shadow: var(--shadow-glow);
            transform: translateY(-2px);
        }
    </style>
}

<div class="auth-wrapper-section auth-page">
    <div class="auth-card-modern auth-container">
        <div class="row g-0">

            <!-- CỘT TRÁI: BANNER -->
            <div class="col-lg-5 d-none d-lg-flex auth-banner-side auth-left">
                <div>
                    <div class="d-inline-flex align-items-center justify-content-center bg-white text-danger rounded-circle p-3 mb-4 shadow-sm" style="width: 64px; height: 64px;">
                        <i class="fa-solid fa-key fa-2x"></i>
                    </div>
                    <h2 class="fw-bold mb-3">Lấy Lại Mật Khẩu</h2>
                    <p class="fs-6 opacity-90 mb-4">
                        Xác thực danh tính bằng Tên đăng nhập và Số điện thoại đã liên kết để thiết lập lại mật khẩu an toàn.
                    </p>
                    <div class="p-3 rounded-3 bg-white bg-opacity-10 small">
                        <i class="fa-solid fa-shield-halved me-1"></i> Mẹo bảo mật: Sử dụng mật khẩu kết hợp chữ hoa, chữ thường và chữ số để tăng độ an toàn.
                    </div>
                </div>
            </div>

            <!-- CỘT PHẢI: FORM QUÊN MẬT KHẨU -->
            <div class="col-lg-7 auth-form-side auth-right">
                <div class="mb-4">
                    <h3 class="fw-bold text-primary mb-1 auth-title">Khôi Phục Mật Khẩu</h3>
                    <p class="text-muted small">Nhập tên đăng nhập và số điện thoại đã đăng ký để tạo mật khẩu mới.</p>
                </div>

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2">
                        <i class="fa-solid fa-circle-exclamation fs-5 flex-shrink-0"></i>
                        <div>@TempData["Error"]</div>
                    </div>
                }

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2">
                        <i class="fa-solid fa-circle-check fs-5 flex-shrink-0"></i>
                        <div>@TempData["Success"]</div>
                    </div>
                }

                <!-- CONTRACT FORM: TenDangNhap, SoDienThoai, MatKhauMoi, XacNhanMatKhauMoi -->
                <form asp-action="QuenMatKhau" method="post">

                    <!-- TÊN ĐĂNG NHẬP -->
                    <div class="auth-input-group form-group">
                        <label class="form-label small fw-semibold text-secondary mb-1">Tên đăng nhập</label>
                        <div class="position-relative">
                            <i class="fa-regular fa-user input-icon"></i>
                            <input asp-for="TenDangNhap"
                                   class="auth-input-control form-control"
                                   placeholder="Nhập tên đăng nhập của bạn..." />
                        </div>
                        <span asp-validation-for="TenDangNhap" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- SỐ ĐIỆN THOẠI -->
                    <div class="auth-input-group form-group">
                        <label class="form-label small fw-semibold text-secondary mb-1">Số điện thoại xác minh</label>
                        <div class="position-relative">
                            <i class="fa-solid fa-phone input-icon"></i>
                            <input asp-for="SoDienThoai"
                                   class="auth-input-control form-control"
                                   placeholder="Nhập số điện thoại đăng ký..." />
                        </div>
                        <span asp-validation-for="SoDienThoai" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- MẬT KHẨU MỚI -->
                    <div class="auth-input-group form-group">
                        <label class="form-label small fw-semibold text-secondary mb-1">Mật khẩu mới</label>
                        <div class="position-relative">
                            <i class="fa-solid fa-lock input-icon"></i>
                            <input asp-for="MatKhauMoi"
                                   type="password"
                                   id="resetNewPwd"
                                   class="auth-input-control form-control"
                                   placeholder="Tối thiểu 6 ký tự..." />
                            <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility('resetNewPwd', this)">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="MatKhauMoi" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- XÁC NHẬN MẬT KHẨU MỚI -->
                    <div class="auth-input-group form-group">
                        <label class="form-label small fw-semibold text-secondary mb-1">Xác nhận mật khẩu mới</label>
                        <div class="position-relative">
                            <i class="fa-solid fa-shield-halved input-icon"></i>
                            <input asp-for="XacNhanMatKhauMoi"
                                   type="password"
                                   id="resetConfirmPwd"
                                   class="auth-input-control form-control"
                                   placeholder="Nhập lại mật khẩu mới..." />
                            <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility('resetConfirmPwd', this)">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="XacNhanMatKhauMoi" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- NÚT GỬI -->
                    <button type="submit" class="btn-auth-submit btn-auth mt-2 mb-3">
                        <i class="fa-solid fa-key me-2"></i>ĐẶT LẠI MẬT KHẨU
                    </button>
                </form>

                <div class="text-center mt-2 pt-3 border-top auth-footer">
                    <a asp-action="DangNhap" class="small fw-semibold text-decoration-none">
                        <i class="fa-solid fa-arrow-left me-1"></i> Quay lại Đăng nhập
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
    </script>
}
