@model ShopeeClone.Models.ViewModels.DangKyViewModel

@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

@section Styles {
    <style>
        .auth-wrapper-section {
            min-height: calc(100vh - 200px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2.5rem 1rem;
            background: linear-gradient(135deg, rgba(238, 77, 45, 0.06) 0%, rgba(255, 115, 55, 0.03) 100%);
        }

        .auth-card-modern {
            background-color: var(--bg-surface);
            border: 1px solid var(--border-default);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-lg);
            overflow: hidden;
            width: 100%;
            max-width: 980px;
        }

        .auth-banner-side {
            background: var(--shopee-gradient);
            color: #ffffff;
            padding: 3rem 2.5rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

        .auth-form-side {
            padding: 3rem 2.5rem;
            background-color: var(--bg-surface);
        }

        .auth-input-group {
            position: relative;
            margin-bottom: 1.15rem;
        }

        .auth-input-group .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 1rem;
            z-index: 2;
        }

        .auth-input-control {
            width: 100%;
            padding: 0.75rem 1rem 0.75rem 2.5rem;
            background-color: var(--bg-surface);
            border: 1.5px solid var(--border-default);
            border-radius: var(--radius-sm);
            color: var(--text-primary);
            font-size: 0.9375rem;
            transition: all var(--transition-fast);
        }

        .auth-input-control:focus {
            outline: none;
            border-color: var(--shopee-orange);
            box-shadow: 0 0 0 3px var(--shopee-orange-glow);
            background-color: var(--bg-surface);
        }

        .toggle-password-btn {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: transparent;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            z-index: 2;
            padding: 4px;
        }

        .btn-auth-submit {
            width: 100%;
            padding: 0.85rem;
            background: var(--shopee-gradient);
            color: #ffffff !important;
            font-weight: 700;
            font-size: 1rem;
            border: none;
            border-radius: var(--radius-sm);
            box-shadow: var(--shadow-glow-sm);
            cursor: pointer;
            transition: all var(--transition-fast);
        }

        .btn-auth-submit:hover {
            box-shadow: var(--shadow-glow);
            transform: translateY(-2px);
        }
    </style>
}

<div class="auth-wrapper-section">
    <div class="auth-card-modern">
        <div class="row g-0">

            <!-- CỘT TRÁI: BANNER -->
            <div class="col-lg-4 d-none d-lg-flex auth-banner-side">
                <div>
                    <div class="d-inline-flex align-items-center justify-content-center bg-white text-danger rounded-circle p-3 mb-4 shadow-sm" style="width: 64px; height: 64px;">
                        <i class="fa-solid fa-user-plus fa-2x"></i>
                    </div>
                    <h2 class="fw-bold mb-3">Tạo Tài Khoản</h2>
                    <p class="fs-6 opacity-90 mb-4">
                        Trở thành thành viên của ShopeeClone ngay hôm nay để nhận trọn bộ Voucher chào mừng lên đến 500K!
                    </p>
                    <ul class="list-unstyled opacity-90 small mb-0">
                        <li class="mb-2"><i class="fa-solid fa-gift me-2"></i> Voucher thành viên mới</li>
                        <li class="mb-2"><i class="fa-solid fa-coins me-2"></i> Tích điểm Shopee Xu mỗi đơn</li>
                        <li><i class="fa-solid fa-bell me-2"></i> Cập nhật Flash Sale chớp nhoáng</li>
                    </ul>
                </div>
            </div>

            <!-- CỘT PHẢI: FORM ĐĂNG KÝ (CONTRACT: HoTen, TenDangNhap, Email, SoDienThoai, DiaChi, MatKhau, XacNhanMatKhau) -->
            <div class="col-lg-8 auth-form-side">
                <div class="mb-4">
                    <h3 class="fw-bold text-primary mb-1">Đăng Ký Tài Khoản</h3>
                    <p class="text-muted small">Điền các thông tin bên dưới để hoàn tất việc đăng ký tài khoản ShopeeClone.</p>
                </div>

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2">
                        <i class="fa-solid fa-circle-exclamation fs-5 flex-shrink-0"></i>
                        <div>@TempData["Error"]</div>
                    </div>
                }

                <form asp-action="DangKy"
                      asp-controller="VwTaiKhoan"
                      method="post"
                      id="registerForm">

                    <div class="row g-2">
                        <!-- HỌ TÊN -->
                        <div class="col-md-6">
                            <div class="auth-input-group">
                                <label class="form-label small fw-semibold text-secondary mb-1">Họ và tên</label>
                                <div class="position-relative">
                                    <i class="fa-regular fa-id-card input-icon"></i>
                                    <input asp-for="HoTen"
                                           class="auth-input-control"
                                           placeholder="Ví dụ: Nguyễn Văn A" />
                                </div>
                                <span asp-validation-for="HoTen" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <!-- TÊN ĐĂNG NHẬP -->
                        <div class="col-md-6">
                            <div class="auth-input-group">
                                <label class="form-label small fw-semibold text-secondary mb-1">Tên đăng nhập</label>
                                <div class="position-relative">
                                    <i class="fa-regular fa-user input-icon"></i>
                                    <input asp-for="TenDangNhap"
                                           class="auth-input-control"
                                           placeholder="Tên viết liền không dấu..." />
                                </div>
                                <span asp-validation-for="TenDangNhap" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <!-- EMAIL -->
                        <div class="col-md-6">
                            <div class="auth-input-group">
                                <label class="form-label small fw-semibold text-secondary mb-1">Email</label>
                                <div class="position-relative">
                                    <i class="fa-regular fa-envelope input-icon"></i>
                                    <input asp-for="Email"
                                           type="email"
                                           class="auth-input-control"
                                           placeholder="example@email.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <!-- SỐ ĐIỆN THOẠI -->
                        <div class="col-md-6">
                            <div class="auth-input-group">
                                <label class="form-label small fw-semibold text-secondary mb-1">Số điện thoại</label>
                                <div class="position-relative">
                                    <i class="fa-solid fa-phone input-icon"></i>
                                    <input asp-for="SoDienThoai"
                                           class="auth-input-control"
                                           placeholder="0912345678" />
                                </div>
                                <span asp-validation-for="SoDienThoai" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <!-- ĐỊA CHỈ -->
                        <div class="col-12">
                            <div class="auth-input-group">
                                <label class="form-label small fw-semibold text-secondary mb-1">Địa chỉ giao hàng</label>
                                <div class="position-relative">
                                    <textarea asp-for="DiaChi"
                                              rows="2"
                                              class="auth-input-control ps-3"
                                              placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố..."></textarea>
                                </div>
                                <span asp-validation-for="DiaChi" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <!-- MẬT KHẨU -->
                        <div class="col-md-6">
                            <div class="auth-input-group">
                                <label class="form-label small fw-semibold text-secondary mb-1">Mật khẩu</label>
                                <div class="position-relative">
                                    <i class="fa-solid fa-lock input-icon"></i>
                                    <input asp-for="MatKhau"
                                           type="password"
                                           id="registerPassword"
                                           class="auth-input-control"
                                           placeholder="Tối thiểu 6 ký tự..." />
                                    <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility('registerPassword', this)">
                                        <i class="fa-regular fa-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="MatKhau" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <!-- XÁC NHẬN MẬT KHẨU -->
                        <div class="col-md-6">
                            <div class="auth-input-group">
                                <label class="form-label small fw-semibold text-secondary mb-1">Xác nhận mật khẩu</label>
                                <div class="position-relative">
                                    <i class="fa-solid fa-shield-halved input-icon"></i>
                                    <input asp-for="XacNhanMatKhau"
                                           type="password"
                                           id="confirmPassword"
                                           class="auth-input-control"
                                           placeholder="Nhập lại mật khẩu..." />
                                    <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility('confirmPassword', this)">
                                        <i class="fa-regular fa-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="XacNhanMatKhau" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                    </div>

                    <!-- NÚT ĐĂNG KÝ -->
                    <button type="submit" class="btn-auth-submit btn-auth mt-2 mb-3">
                        <i class="fa-solid fa-user-check me-2"></i>HOÀN TẤT ĐĂNG KÝ
                    </button>
                </form>

                <div class="text-center mt-2 pt-3 border-top">
                    <span class="text-muted small">Đã có tài khoản ShopeeClone?</span>
                    <a asp-action="DangNhap" asp-controller="VwTaiKhoan" class="small fw-bold text-decoration-none ms-1">
                        Đăng nhập ngay
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
    </script>
}
