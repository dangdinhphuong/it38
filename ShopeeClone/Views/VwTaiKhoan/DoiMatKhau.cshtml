@model ShopeeClone.Models.ViewModels.DoiMatKhauViewModel

@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header">
            <h4>Đổi mật khẩu</h4>
        </div>

        <div class="card-body">

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            <form asp-action="DoiMatKhau"
                  method="post">

                <div class="mb-3">
                    <label>Mật khẩu cũ</label>

                    <input asp-for="MatKhauCu"
                           type="password"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Mật khẩu mới</label>

                    <input asp-for="MatKhauMoi"
                           type="password"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Xác nhận mật khẩu mới</label>

                    <input asp-for="XacNhanMatKhauMoi"
                           type="password"
                           class="form-control" />
                </div>

                <button type="submit"
                        class="btn btn-danger">
                    Đổi mật khẩu
                </button>

            </form>

        </div>

    </div>

</div>