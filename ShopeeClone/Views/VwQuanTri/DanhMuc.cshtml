@model List<ShopeeClone.Models.Model_DB.DanhMuc>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý danh mục";
}

<link rel="stylesheet" href="~/css/admin.css" />

<div class="admin-wrapper">

    <div class="content-area">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <h2>Quản lý danh mục</h2>

            <button class="btn btn-admin"
                    data-bs-toggle="modal"
                    data-bs-target="#modalThem">

                + Thêm danh mục

            </button>

        </div>

        <table class="table table-bordered align-middle">

            <thead>

                <tr>

                    <th>ID</th>

                    <th>Ảnh</th>

                    <th>Tên danh mục</th>

                    <th width="180">
                        Chức năng
                    </th>

                </tr>

            </thead>

            <tbody id="tableDanhMuc">

                @foreach (var item in Model)
                {
                    <tr id="row_@item.MaDanhMuc">

                        <td>
                            @item.MaDanhMuc
                        </td>

                        <td>

                            @if (!string.IsNullOrEmpty(item.HinhAnh))
                            {
                                <img src="@item.HinhAnh"
                                     width="70"
                                     class="img-thumbnail" />
                            }
                            else
                            {
                                <span class="text-muted">
                                    Chưa có ảnh
                                </span>
                            }

                        </td>

                        <td>
                            @item.TenDanhMuc
                        </td>

                        <td>

                            <button class="btn btn-warning btn-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#edit_@item.MaDanhMuc">

                                Sửa

                            </button>

                            <button class="btn btn-danger btn-sm"
                                    onclick="xoaDanhMuc(@item.MaDanhMuc)">

                                Xóa

                            </button>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<!-- MODAL EDIT -->
@foreach (var item in Model)
{
    <div class="modal fade"
         id="edit_@item.MaDanhMuc"
         tabindex="-1">

        <div class="modal-dialog">

            <div class="modal-content">

                <form class="formSuaDanhMuc"
                      enctype="multipart/form-data">

                    <div class="modal-header">

                        <h5>
                            Sửa danh mục
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>

                    </div>

                    <div class="modal-body">

                        <input type="hidden"
                               name="MaDanhMuc"
                               value="@item.MaDanhMuc" />

                        <input type="hidden"
                               name="HinhAnh"
                               value="@item.HinhAnh" />

                        <input class="form-control mb-3"
                               name="TenDanhMuc"
                               value="@item.TenDanhMuc" />

                        @if (!string.IsNullOrEmpty(item.HinhAnh))
                        {
                            <div class="mb-3 text-center">

                                <img src="@item.HinhAnh"
                                     width="120"
                                     class="img-thumbnail" />

                            </div>
                        }

                        <input class="form-control"
                               type="file"
                               name="fileAnh" />

                    </div>

                    <div class="modal-footer">

                        <button type="submit"
                                class="btn btn-success">

                            Lưu

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>
}

<!-- MODAL THÊM -->
<div class="modal fade"
     id="modalThem"
     tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <form id="formThemDanhMuc"
                  enctype="multipart/form-data">

                <div class="modal-header">

                    <h5>
                        Thêm danh mục
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <input class="form-control mb-3"
                           name="TenDanhMuc"
                           placeholder="Tên danh mục" />

                    <input class="form-control"
                           type="file"
                           name="fileAnh" />

                </div>

                <div class="modal-footer">

                    <button type="submit"
                            class="btn btn-primary">

                        Thêm

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<script>

    // THÊM DANH MỤC
    document.getElementById("formThemDanhMuc")
        .addEventListener("submit", async function (e) {

            e.preventDefault();

            let formData = new FormData(this);

            let response = await fetch('/VwQuanTri/ThemDanhMuc', {
                method: 'POST',
                body: formData
            });

            let result = await response.json();

            if (result.success) {

                let dm = result.data;

                let html = `
                    <tr id="row_${dm.maDanhMuc}">

                        <td>
                            ${dm.maDanhMuc}
                        </td>

                        <td>

                            <img src="${dm.hinhAnh}"
                                 width="70"
                                 class="img-thumbnail" />

                        </td>

                        <td>
                            ${dm.tenDanhMuc}
                        </td>

                        <td>

                            <button class="btn btn-warning btn-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#edit_${dm.maDanhMuc}">

                                Sửa

                            </button>

                            <button class="btn btn-danger btn-sm"
                                    onclick="xoaDanhMuc(${dm.maDanhMuc})">

                                Xóa

                            </button>

                        </td>

                    </tr>
                `;

                document.getElementById("tableDanhMuc")
                    .insertAdjacentHTML("beforeend", html);

                bootstrap.Modal.getInstance(
                    document.getElementById('modalThem')
                ).hide();

                document.getElementById("formThemDanhMuc")
                    .reset();

            } else {

                alert(result.message);

            }

        });

    // SỬA DANH MỤC
    document.querySelectorAll(".formSuaDanhMuc")
        .forEach(form => {

            form.addEventListener("submit", async function (e) {

                e.preventDefault();

                let formData = new FormData(this);

                let response = await fetch('/VwQuanTri/SuaDanhMuc', {
                    method: 'POST',
                    body: formData
                });

                let result = await response.json();

                if (result.success) {

                    let dm = result.data;

                    let row =
                        document.getElementById(
                            "row_" + dm.maDanhMuc
                        );

                    row.innerHTML = `
                        <td>
                            ${dm.maDanhMuc}
                        </td>

                        <td>

                            <img src="${dm.hinhAnh}"
                                 width="70"
                                 class="img-thumbnail" />

                        </td>

                        <td>
                            ${dm.tenDanhMuc}
                        </td>

                        <td>

                            <button class="btn btn-warning btn-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#edit_${dm.maDanhMuc}">

                                Sửa

                            </button>

                            <button class="btn btn-danger btn-sm"
                                    onclick="xoaDanhMuc(${dm.maDanhMuc})">

                                Xóa

                            </button>

                        </td>
                    `;

                    bootstrap.Modal.getInstance(
                        form.closest('.modal')
                    ).hide();

                } else {

                    alert(result.message);

                }

            });

        });

    // XÓA DANH MỤC
    async function xoaDanhMuc(id) {

        if (!confirm('Bạn có chắc chắn muốn xóa danh mục?'))
            return;

        let response =
            await fetch('/VwQuanTri/XoaDanhMuc/' + id, {

                method: 'POST'

            });

        let result = await response.json();

        if (result.success) {

            document.getElementById("row_" + id)
                .remove();

        } else {

            alert(result.message);

        }

    }

</script>