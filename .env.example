# ================================================================
# Cấu hình môi trường cho Docker Compose (ShopeeClone)
# ================================================================

# Mật khẩu SA cho SQL Server (tối thiểu 8 ký tự, gồm chữ hoa, chữ thường, số, ký tự đặc biệt)
SA_PASSWORD=ShopeeClone@2026!

# Cổng truy cập ứng dụng ShopeeClone trên máy host (mặc định: 5017)
APP_PORT=5017

# Cổng SQL Server trên máy host (nếu muốn kết nối từ tool ngoài như Azure Data Studio/DBeaver/SSMS)
MSSQL_PORT=1433

# Môi trường chạy ứng dụng ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

